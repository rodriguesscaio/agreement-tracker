# Anthropic API key used for extraction (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PostgreSQL connection string (SQLAlchemy + psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agreement_tracker

# Claude model used for extraction. Overridable without touching code.
CLAUDE_MODEL=claude-sonnet-4-6
