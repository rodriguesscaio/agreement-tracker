# OpenAI API key used for extraction (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# PostgreSQL connection string (SQLAlchemy + psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agreement_tracker

# OpenAI model used for extraction. Overridable without touching code.
OPENAI_MODEL=gpt-4o-mini
